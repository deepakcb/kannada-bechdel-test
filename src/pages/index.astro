---
import Base from "../layouts/Base.astro";
import MovieCard from "../components/MovieCard.astro";
import ScoreOverview from "../components/ScoreOverview.astro";
import movies from "../data/movies.json";

const years = [...new Set(movies.map((m) => m.year))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
  year,
  movies: movies.filter((m) => m.year === year),
}));

const passCount = movies.filter((m) => m.result.toLowerCase().startsWith("pass")).length;
---
<Base title="Kannada Bechdel Test — Top 5 Kannada Movies by Year">
  <section class="intro wrap">
    <h1>Does Kannada cinema pass the Bechdel test?</h1>
    <p class="kn-subtitle">ಕನ್ನಡ ಚಿತ್ರರಂಗ ಬೆಕ್ ಡೆಲ್ ಟೆಸ್ಟ್ ಅನ್ನು ಪಾಸ್ ಮಾಡುತ್ತದೆಯೇ?</p>
    <p>
      Every year we take the top 5 box-office Kannada releases and check them against
      the{" "}<a href="/about/">Bechdel test</a>: do at least two named women talk to each other
      about something other than a man? Here's how {movies.length} films from {years[years.length - 1]}–{years[0]} stack up.
    </p>
    <p class="stat"><strong>{passCount}</strong> of <strong>{movies.length}</strong> films pass.</p>
  </section>

  <section class="wrap">
    <ScoreOverview byYear={byYear} />
  </section>

  <div class="year-controls wrap">
    <button id="toggle-all" type="button" hidden>Expand all</button>
  </div>

  {byYear.map(({ year, movies: yearMovies }) => {
    const yearPassCount = yearMovies.filter((m) => m.result.toLowerCase().startsWith("pass")).length;
    return (
      <details class="year-block wrap" id={`y${year}`} open={year === years[0]}>
        <summary>
          <h2>{year}</h2>
          <span class="year-meta">{yearPassCount}/{yearMovies.length} pass</span>
          <span class="chevron" aria-hidden="true">›</span>
        </summary>
        <div class="grid">
          {yearMovies.map((movie) => <MovieCard movie={movie} />)}
        </div>
      </details>
    );
  })}

  <script>
    const detailsEls = () => Array.from(document.querySelectorAll<HTMLDetailsElement>("details.year-block"));
    const toggleBtn = document.getElementById("toggle-all");

    function updateButtonLabel() {
      if (!toggleBtn) return;
      const allOpen = detailsEls().every((d) => d.open);
      toggleBtn.textContent = allOpen ? "Collapse all" : "Expand all";
      toggleBtn.hidden = false;
    }

    toggleBtn?.addEventListener("click", () => {
      const allOpen = detailsEls().every((d) => d.open);
      detailsEls().forEach((d) => { d.open = !allOpen; });
      updateButtonLabel();
    });

    detailsEls().forEach((d) => d.addEventListener("toggle", updateButtonLabel));
    updateButtonLabel();

    function openFromHash() {
      const id = location.hash.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el instanceof HTMLDetailsElement) {
        el.open = true;
        updateButtonLabel();
      }
    }
    openFromHash();
    window.addEventListener("hashchange", openFromHash);
  </script>
</Base>

<style>
  .intro {
    padding-top: 48px;
    padding-bottom: 8px;
    max-width: 720px;
  }
  .intro h1 {
    font-size: 1.9rem;
    margin: 0 0 6px;
  }
  .kn-subtitle {
    color: var(--muted);
    font-size: 1.05rem;
    margin: 0 0 16px;
  }
  .intro p {
    color: var(--muted);
    font-size: 1rem;
  }
  .intro .stat {
    color: var(--ink);
    font-size: 1.05rem;
  }
  .intro .stat strong { color: var(--accent); }
  .year-controls {
    display: flex;
    justify-content: flex-end;
    padding-top: 28px;
  }
  .year-controls button {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
  }
  .year-controls button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .year-block {
    padding-top: 20px;
    padding-bottom: 36px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 20px;
  }
  .year-block summary {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    list-style: none;
    padding: 16px 0;
    margin: -16px 0 0;
  }
  .year-block summary::-webkit-details-marker {
    display: none;
  }
  .year-block summary:hover h2 {
    color: var(--accent);
  }
  .year-block h2 {
    font-size: 1.4rem;
    margin: 0;
  }
  .year-meta {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .chevron {
    margin-left: auto;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }
  .year-block[open] .chevron {
    transform: rotate(90deg);
  }
  .year-block .grid {
    margin-top: 18px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
</style>
